# ===============================================================================
# SUPABASE (app + edge functions)
# ===============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side / Edge Functions ONLY. Never expose this
# to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===============================================================================
# PAYSTACK (test mode)
# ===============================================================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===============================================================================
# TERMII (OTP SMS)
# ===============================================================================
TERMII_API_KEY=
TERMII_SENDER_ID=SwiftMart

# ===============================================================================
# CLOUDFLARE R2 (product/post image uploads)
# ===============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swiftmart-media
R2_PUBLIC_URL=https://media.yourdomain.com

# ===============================================================================
# SWIFTMART AI (Admin AI assistant & separate AI Supabase project)
# ===============================================================================
AI_SUPABASE_URL=
AI_SUPABASE_ANON_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ===============================================================================
# APP
# ===============================================================================
FRONTEND_URL=http://localhost:3000

# Required to sign admin/vendor dashboard PIN sessions (server only; 32+ random characters)
DASHBOARD_SESSION_SECRET=
# Optional dashboard PIN session lifetime, in seconds (default 28800, maximum 86400)
DASHBOARD_SESSION_TTL_SECONDS=28800
